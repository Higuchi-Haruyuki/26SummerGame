{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug x64)",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}\\26SummerGame.vcxproj",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m",
                "/nologo"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build (Release x64)",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}\\26SummerGame.vcxproj",
                "/p:Configuration=Release",
                "/p:Platform=x64",
                "/m",
                "/nologo"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean (Debug x64)",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}\\26SummerGame.vcxproj",
                "/t:Clean",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/nologo"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
